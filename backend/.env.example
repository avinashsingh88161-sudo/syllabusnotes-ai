# ============================================================
# ENVIRONMENT VARIABLES — Copy this to .env and fill in values
# ============================================================

# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://localhost:27017/syllabus_notes

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d

# AI Providers (Google Gemini or OpenAI)
# Gemini is recommended (generous free tier & 1M+ token context)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# OpenAI (Alternative)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Razorpay (India Payment Gateway)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret

# Subscription Price (in paise — 1 INR = 100 paise)
PREMIUM_PRICE_PAISE=49900

# Free tier limits
FREE_UPLOAD_LIMIT=3

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# File upload size limit (in bytes, default 10MB)
MAX_FILE_SIZE=10485760
